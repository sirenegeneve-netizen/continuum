# Copiez ce fichier en backend/.env puis renseignez les valeurs. Ne commitez jamais backend/.env.

# Clé de signature des sessions (OBLIGATOIRE en production, 32 caractères minimum).
# Générer :  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Compte super administrateur créé au premier démarrage.
# Si ADMIN_PASSWORD est vide, un mot de passe aléatoire est généré et affiché une seule fois dans la console.
ADMIN_EMAIL=admin@continuum.fr
ADMIN_PASSWORD=

# Adresses autorisées à appeler l'API depuis un navigateur (séparées par des virgules).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# GitHub Codespaces : autoriser les adresses *.app.github.dev
# CORS_ORIGIN_REGEX=https://.*\.app\.github\.dev

# Base de données (SQLite par défaut)
# DATABASE_URL=sqlite:///./continuum.db

# Durée d'une session en minutes
# ACCESS_TOKEN_EXPIRE_MINUTES=60
