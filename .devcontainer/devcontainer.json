{
  "name": "Continuum",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postStartCommand": "bash scripts/codespace-start.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Continuum",
      "onAutoForward": "openBrowser"
    }
  }
}
